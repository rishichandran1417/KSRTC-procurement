# Base backend URL (database-backed API: inventory, purchase orders, suppliers, chat)
VITE_API_BASE_URL=

# ML demand forecasting service
VITE_FORECAST_API_URL=

# PuLP procurement optimization service
VITE_OPTIMIZATION_API_URL=

# Power BI report embed URL
VITE_POWERBI_EMBED_URL=

# Google Gemini API Key (Direct API call or backend proxy)
VITE_GEMINI_API_KEY=

# When true, the app runs on simulated/in-memory services.
# Set to false once your backend services or VITE_GEMINI_API_KEY are configured.
VITE_DEMO_MODE=true
